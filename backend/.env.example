# Database
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=emergency_platform

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# MinIO
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=attachments
MINIO_USE_SSL=false

# App
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Auth/OTP (mock mode by default for dev)
AUTH_JWT_SECRET=dev-jwt-secret-change-me
AUTH_REFRESH_SECRET=dev-refresh-secret-change-me
OTP_PROVIDER=mock
