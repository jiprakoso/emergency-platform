{
  "name": "emergency-platform-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Emergency incident management backend (NestJS) - sample demo",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"test/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "migration:run": "ts-node -T --project tsconfig.migrations.json src/database/migrate.ts run",
    "migration:revert": "ts-node -T --project tsconfig.migrations.json src/database/migrate.ts revert",
    "migration:show": "ts-node -T --project tsconfig.migrations.json src/database/migrate.ts show",
    "seed:base": "ts-node -T --project tsconfig.migrations.json src/cli/seed.ts base",
    "seed:verify": "ts-node -T --project tsconfig.migrations.json src/cli/seed.ts verify",
    "seed:reset-live": "ts-node -T --project tsconfig.migrations.json src/cli/seed.ts reset-live",
    "test": "jest",
    "test:e2e": "jest --config test/jest-e2e.js",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@nestjs-modules/ioredis": "^2.0.2",
    "@nestjs/common": "^10.4.6",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.6",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.6",
    "@nestjs/typeorm": "^10.0.2",
    "@types/uuid": "^11.0.0",
    "argon2": "^0.45.1",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "commander": "^15.0.0",
    "dotenv": "^18.0.8",
    "express": "^4.22.1",
    "helmet": "^8.3.0",
    "ioredis": "^5.4.1",
    "nestjs-pino": "^4.1.0",
    "otplib": "^13.5.0",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5",
    "typeorm": "^0.3.20",
    "uuid": "^14.0.3",
    "yaml": "^2"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.7",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.6",
    "@types/bcryptjs": "2",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "ajv": "^8",
    "ajv-formats": "^3",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^29.7.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.3"
  },
  "packageManager": "pnpm@8.15.6"
}